# /etc/tilingvol/tilingvol.env  (root:tilingvol, mode 0640)
# Generate the key once with:  python3 -c "import secrets; print(secrets.token_hex(32))"
# The same key goes into the .env used by scripts/build_client.py. Never commit it.
TILINGVOL_SUBMIT_KEY=
TILINGVOL_DB=/var/lib/tilingvol/tilingvol.sqlite3
TILINGVOL_PIECE=gun
# share of handed-out sizes that use battleship order (the rest go smallest area first)
TILINGVOL_BATTLE_SHARE=0.5
# 1 = also hand out sizes that already timed out, once nothing else is left
TILINGVOL_RETRY_TIMED_OUT=0
# optional: folder whose files are offered on the public page (put the built apps here)
TILINGVOL_DOWNLOAD_DIR=/var/lib/tilingvol/downloads
# Border stages. By default each size starts at the border depth that settled the nearest decided size,
# then goes BORDER_INCREMENTS steps of BORDER_STEP deeper, then the full search (each stage up to
# STAGE_TIME_LIMIT_S seconds). Set TILINGVOL_ADAPTIVE_BORDERS=0 to use the fixed 20 -> 26 -> full.
TILINGVOL_DEFAULT_BORDER=20
TILINGVOL_BORDER_STEP=2
TILINGVOL_BORDER_INCREMENTS=2
TILINGVOL_STAGE_TIME_LIMIT_S=10800
# Optional: only people with one of these tokens (comma-separated, 16+ characters each) can run sizes.
# Make one per person with: python3 -c "import secrets; print(secrets.token_urlsafe(16))"
# They paste it into the app under Advanced > Access token. Leave empty to let anyone help.
TILINGVOL_ACCESS_TOKENS=
