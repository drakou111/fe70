# /etc/tilingvol/tilingvol.env  (root:tilingvol, mode 0640)
# Generate the key once with:  python3 -c "import secrets; print(secrets.token_hex(32))"
# The same key goes into the .env used by scripts/build_client.py. Never commit it.
TILINGVOL_SUBMIT_KEY=
TILINGVOL_DB=/var/lib/tilingvol/tilingvol.sqlite3
TILINGVOL_PIECE=gun
# share of handed-out sizes that use battleship order (the rest go smallest area first)
TILINGVOL_BATTLE_SHARE=0.5
# 1 = also hand out sizes that already timed out, once nothing else is left
TILINGVOL_RETRY_TIMED_OUT=0
# optional: folder whose files are offered on the public page (put the built apps here)
TILINGVOL_DOWNLOAD_DIR=/var/lib/tilingvol/downloads
